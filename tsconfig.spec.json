{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "rootDir": ".",
    "types": ["node", "vitest/globals"],
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/spec.tsbuildinfo"
  },
  "include": ["tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
